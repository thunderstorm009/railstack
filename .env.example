# ReliStack environment configuration.
#
# Copy to `.env` and adjust. Compose reads `.env` automatically for variable
# interpolation, and the file is git-ignored so secrets never reach the repo.
#
# Current defaults live in docker-compose.yml, so a clean clone works without
# this file. It exists to document the knobs and to make them overridable.

# Host port the proxy listens on. Change to 8081 if 8080 is already taken.
RELAISTACK_HTTP_PORT=8080

# Container name prefix (used by the scripts to find containers).
RELAISTACK_NAME_PREFIX=relistack

# Memory limit for the api service, in megabytes. Lower it (e.g. 64) to make
# the OOM experiment (E4) fail faster and more reliably.
RELAISTACK_API_MEMORY_LIMIT=256M

# Seconds Docker waits between SIGTERM and SIGKILL when stopping a container.
RELAISTACK_STOP_GRACE_PERIOD=10
